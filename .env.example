# Copy this file to .env (same folder) and fill in the values.
# .env is gitignored: it never leaves your Mac. Never paste keys into chat.

# Google AI Studio / Google Cloud API key.
# Used for Gemini images (generativelanguage.googleapis.com) and,
# if Text-to-Speech is enabled on the same project, for the voiceover.
GOOGLE_API_KEY=

# Optional: a separate key for Text-to-Speech if you restrict keys per API.
# Leave empty to reuse GOOGLE_API_KEY.
GOOGLE_TTS_API_KEY=
