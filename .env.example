# Copy this file to .env (same folder) and fill in the values.
# .env is gitignored: it never leaves your Mac. Never paste keys into chat.

# Google AI Studio API key (https://aistudio.google.com/apikey).
# Pays for images and the Gemini voice.
GOOGLE_API_KEY=

# Only if you switch to TTS_PROVIDER=chirp (Google Cloud Text-to-Speech). Leave empty otherwise.
GOOGLE_TTS_API_KEY=
